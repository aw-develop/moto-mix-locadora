# Runtime secrets only. Never expose them through VITE_* or Angular configuration.
# Use npm run admin:setup to choose a password privately and upload the secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_SALT_COLON_PBKDF2_SHA256_HASH
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
