{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false
  },
  "projects": {
    "mix-locadora": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "mix",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": ".angular/site-client",
              "browser": "browser"
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/cyan-orange.css",
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts",
              "experimentalPlatform": "neutral"
            },
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "mixlocadora.com.br",
                "www.mixlocadora.com.br",
                "mix-locadora-angular.operacional-825.workers.dev",
                "localhost",
                "127.0.0.1",
                "terminal.local"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mix-locadora:build:production"
            },
            "development": {
              "buildTarget": "mix-locadora:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "mix-locadora:build:development",
            "runner": "vitest"
          }
        }
      }
    }
  }
}
